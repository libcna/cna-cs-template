{
  "$schema": "http://json.schemastore.org/template",
  "author": "openeggbert",
  "classifications": ["Games", "CNA", "XNA"],
  "identity": "OpenEggbert.CNA.Game.CSharp",
  "name": "CNA C# XNA-style game",
  "shortName": "cna-game",
  "sourceName": "CnaCsTemplate",
  "preferNameDirectory": true,
  "description": "A native-CNA-backed C# game with portable XNA-style game code.",
  "primaryOutputs": [
    { "path": "CnaCsTemplate.csproj" }
  ],
  "symbols": {
    "consumerMode": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "Development",
      "description": "Choose source/project-reference development or isolated local-package consumption.",
      "choices": [
        { "choice": "Development", "description": "Reference a CNA.NET source checkout." },
        { "choice": "Package", "description": "Reference CNA.XnaCompat from a configured NuGet feed." }
      ]
    },
    "cnaPackageVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.1.0-local.1",
      "description": "CNA.XnaCompat version used in Package consumer mode.",
      "replaces": "CnaPackageVersion"
    }
  },
  "sources": [
    {
      "modifiers": [
        { "exclude": [".git/**", "bin/**", "obj/**", "Directory.Build.props", "scripts/**"] }
      ]
    }
  ]
}
