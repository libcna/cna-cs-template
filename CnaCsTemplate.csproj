<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CnaCsTemplate</RootNamespace>

    <!-- CNA is the product default. The other values keep this repository useful as a source
         portability harness; generated games can delete the unused conditional groups. -->
    <Engine Condition="'$(Engine)' == ''">CNA</Engine>

<!--#if (consumerMode == "Package")-->
    <!-- Which consumer mode the *generated* project is in. `dotnet new` deletes whichever of these
         two blocks does not apply, so a generated game sets exactly one.

         In this repository neither block is deleted, and the Development one comes second, so the
         repository builds as a Development consumer. That is deliberate: the checked-in project is
         a working game as well as a template, and it used to fail restore outright with
         "'CnaPackageVersion' is not a valid version string" because the Package-mode
         PackageReference below was conditioned only on the engine and was therefore always live
         here. Nothing but `dotnet new` had ever evaluated this file. -->
    <CnaConsumerMode>Package</CnaConsumerMode>
<!--#endif-->
<!--#if (consumerMode == "Development")-->
    <CnaConsumerMode>Development</CnaConsumerMode>

    <!-- Environment variables are imported as MSBuild properties. This repository's optional
         sibling-checkout convenience lives in Directory.Build.props, which template.json excludes
         from generated games. -->
    <CnaCsRoot Condition="'$(CnaCsRoot)' == '' and '$(CNA_CS_ROOT)' != ''">$(CNA_CS_ROOT)</CnaCsRoot>
<!--#endif-->
    <FnaFrameworkPath Condition="'$(FnaFrameworkPath)' == '' and '$(FNA_FRAMEWORK_PATH)' != ''">$(FNA_FRAMEWORK_PATH)</FnaFrameworkPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Engine)' == 'CNA'">
    <DefineConstants>$(DefineConstants);ENGINE_CNA</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Engine)' == 'MonoGame'">
    <DefineConstants>$(DefineConstants);ENGINE_MONOGAME</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Engine)' == 'FNA'">
    <DefineConstants>$(DefineConstants);ENGINE_FNA</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Engine)' == 'Kni'">
    <DefineConstants>$(DefineConstants);ENGINE_KNI</DefineConstants>
  </PropertyGroup>

<!--#if (consumerMode == "Development")-->
  <ItemGroup Condition="'$(Engine)' == 'CNA' and '$(CnaConsumerMode)' == 'Development' and '$(CnaCsRoot)' != ''">
    <ProjectReference Include="$(CnaCsRoot)\src\CNA.XnaCompat\CNA.XnaCompat.csproj" />
  </ItemGroup>

  <Target Name="ValidateCnaReference" BeforeTargets="ResolveProjectReferences"
          Condition="'$(Engine)' == 'CNA' and '$(CnaConsumerMode)' == 'Development'">
    <Error Condition="'$(CnaCsRoot)' == ''"
           Text="CNA.XnaCompat was not found. Set CNA_CS_ROOT or pass -p:CnaCsRoot=/path/to/cna-cs." />
    <Error Condition="'$(CnaCsRoot)' != '' and !Exists('$(CnaCsRoot)\src\CNA.XnaCompat\CNA.XnaCompat.csproj')"
           Text="CnaCsRoot='$(CnaCsRoot)' does not contain src/CNA.XnaCompat/CNA.XnaCompat.csproj." />
  </Target>
<!--#endif-->

<!--#if (consumerMode == "Package")-->
  <ItemGroup Condition="'$(Engine)' == 'CNA' and '$(CnaConsumerMode)' == 'Package'">
    <PackageReference Include="CNA.XnaCompat" Version="CnaPackageVersion" />
  </ItemGroup>
<!--#endif-->

  <ItemGroup Condition="'$(Engine)' == 'MonoGame'">
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup Condition="'$(Engine)' == 'FNA' and '$(FnaFrameworkPath)' != ''">
    <Reference Include="FNA" HintPath="$(FnaFrameworkPath)" Private="true" />
  </ItemGroup>

  <Target Name="ValidateFnaReference" BeforeTargets="ResolveReferences" Condition="'$(Engine)' == 'FNA'">
    <Error Condition="'$(FnaFrameworkPath)' == ''"
           Text="FNA.dll was not configured. Set FNA_FRAMEWORK_PATH or pass -p:FnaFrameworkPath=/path/to/FNA.dll." />
    <Error Condition="'$(FnaFrameworkPath)' != '' and !Exists('$(FnaFrameworkPath)')"
           Text="FnaFrameworkPath='$(FnaFrameworkPath)' does not exist." />
  </Target>

  <ItemGroup Condition="'$(Engine)' == 'Kni'">
    <PackageReference Include="nkast.Xna.Framework" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.2.9001" />
    <!-- The modular framework packages compile without registering a desktop GameFactory. -->
    <PackageReference Include="nkast.Kni.Platform.SDL2.GL" Version="4.2.9001.1" />
  </ItemGroup>

  <!-- The browser and Android heads (Platforms/) compile these same sources in their own projects. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Platforms/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Content\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
