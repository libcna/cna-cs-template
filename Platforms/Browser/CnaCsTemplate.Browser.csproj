<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    The game in a browser: the same sources and Content as ../../CnaCsTemplate.csproj, on CNA.NET's
    WebAssembly host (cna-cs eng/browser). Needs the .NET 11 SDK with the wasm-tools workload, and
    the CNA archive cna-cs's scripts/Build-BrowserNative.sh stages; CNA is linked into
    dotnet.native.wasm. A development consumer: CnaCsRoot or CNA_CS_ROOT names the cna-cs checkout.

      dotnet publish Platforms/Browser -c Release      # then serve bin/Release/net11.0/publish/wwwroot
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>CnaCsTemplate</AssemblyName>
    <RootNamespace>CnaCsTemplate</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);ENGINE_CNA</DefineConstants>
    <CnaCsRoot Condition="'$(CnaCsRoot)' == '' and '$(CNA_CS_ROOT)' != ''">$(CNA_CS_ROOT)</CnaCsRoot>
    <!-- Copied into the page's file system by CNA.NET's browser targets (into wwwroot/Content here). -->
    <CnaGameContentDirectory>$(MSBuildThisFileDirectory)../../Content</CnaGameContentDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../*.cs" />
    <ProjectReference Include="$(CnaCsRoot)/src/CNA.XnaCompat/CNA.XnaCompat.csproj" />
  </ItemGroup>

  <Import Project="$(CnaCsRoot)/src/CNA.XnaCompat/build/CNA.XnaCompat.targets" Condition="'$(CnaCsRoot)' != ''" />
  <Import Project="$(CnaCsRoot)/eng/browser/CNA.Browser.targets" Condition="'$(CnaCsRoot)' != ''" />

  <Target Name="ValidateCnaReference" BeforeTargets="ResolveProjectReferences">
    <Error Condition="'$(CnaCsRoot)' == ''" Text="Set CNA_CS_ROOT or pass -p:CnaCsRoot=/path/to/cna-cs." />
  </Target>

</Project>
