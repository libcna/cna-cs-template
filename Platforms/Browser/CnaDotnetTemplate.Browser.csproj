<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    The game in a browser: the same sources and Content as ../../CnaDotnetTemplate.csproj, on CNA.NET's
    WebAssembly host (cna-dotnet eng/browser). Needs the .NET 11 SDK with the wasm-tools workload, and
    the CNA archive cna-dotnet's scripts/Build-BrowserNative.sh stages; CNA is linked into
    dotnet.native.wasm. A development consumer: CnaDotnetRoot or CNA_DOTNET_ROOT names the cna-dotnet checkout.

      dotnet publish Platforms/Browser -c Release      # then serve bin/Release/net11.0/publish/wwwroot
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>CnaDotnetTemplate</AssemblyName>
    <RootNamespace>CnaDotnetTemplate</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);ENGINE_CNA</DefineConstants>
    <CnaDotnetRoot Condition="'$(CnaDotnetRoot)' == '' and '$(CNA_DOTNET_ROOT)' != ''">$(CNA_DOTNET_ROOT)</CnaDotnetRoot>
    <!-- Copied into the page's file system by CNA.NET's browser targets (into wwwroot/Content here). -->
    <CnaGameContentDirectory>$(MSBuildThisFileDirectory)../../Content</CnaGameContentDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../*.cs" />
    <ProjectReference Include="$(CnaDotnetRoot)/src/CNA.XnaCompat/CNA.XnaCompat.csproj" />
  </ItemGroup>

  <Import Project="$(CnaDotnetRoot)/src/CNA.XnaCompat/build/CNA.XnaCompat.targets" Condition="'$(CnaDotnetRoot)' != ''" />
  <Import Project="$(CnaDotnetRoot)/eng/browser/CNA.Browser.targets" Condition="'$(CnaDotnetRoot)' != ''" />

  <Target Name="ValidateCnaReference" BeforeTargets="ResolveProjectReferences">
    <Error Condition="'$(CnaDotnetRoot)' == ''" Text="Set CNA_DOTNET_ROOT or pass -p:CnaDotnetRoot=/path/to/cna-dotnet." />
  </Target>

</Project>
