<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The game on Android: the same sources and Content as ../../CnaDotnetTemplate.csproj, in SDL's activity
    with CNA.NET's Android host (cna-dotnet eng/android). Needs the .NET 11 SDK with the android workload,
    the Android SDK and NDK, and the libraries cna-dotnet's scripts/Build-AndroidNative.sh stages. A
    development consumer: CnaDotnetRoot or CNA_DOTNET_ROOT names the cna-dotnet checkout.

      dotnet build Platforms/Android -c Release -t:Install    # onto the running emulator or device
  -->
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <AssemblyName>CnaDotnetTemplate</AssemblyName>
    <RootNamespace>CnaDotnetTemplate</RootNamespace>
    <ApplicationTitle>CnaDotnetTemplate</ApplicationTitle>
    <ApplicationId>com.example.$([System.Text.RegularExpressions.Regex]::Replace($(AssemblyName.ToLowerInvariant()), '[^a-z0-9]', ''))</ApplicationId>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">android-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AndroidResgenNamespace>CnaAndroidResources</AndroidResgenNamespace>
    <DefineConstants>$(DefineConstants);ENGINE_CNA</DefineConstants>
    <CnaDotnetRoot Condition="'$(CnaDotnetRoot)' == '' and '$(CNA_DOTNET_ROOT)' != ''">$(CNA_DOTNET_ROOT)</CnaDotnetRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../*.cs" />
    <Compile Include="GameApplication.cs" />
    <ProjectReference Include="$(CnaDotnetRoot)/src/CNA.XnaCompat/CNA.XnaCompat.csproj" />
    <!-- Extracted beside the game on the device by CnaGameApplication before Main runs. -->
    <AndroidAsset Include="../../Content/**" Link="Assets/Content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="$(CnaDotnetRoot)/src/CNA.XnaCompat/build/CNA.XnaCompat.targets" Condition="'$(CnaDotnetRoot)' != ''" />
  <Import Project="$(CnaDotnetRoot)/eng/android/CNA.Android.targets" Condition="'$(CnaDotnetRoot)' != ''" />

  <Target Name="ValidateCnaReference" BeforeTargets="ResolveProjectReferences">
    <Error Condition="'$(CnaDotnetRoot)' == ''" Text="Set CNA_DOTNET_ROOT or pass -p:CnaDotnetRoot=/path/to/cna-dotnet." />
  </Target>

</Project>
